{
  "name": "backtester-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "seed:demo": "node scripts/seed-demo.ts",
    "lint": "oxlint --deny-warnings",
    "test:coverage": "node -e \"require('fs').mkdirSync('coverage',{recursive:true})\" && node --test --experimental-test-coverage --test-coverage-exclude=\"src/**/*.test.ts\" --test-coverage-exclude=\"src/test*.ts\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "oxlint": "^1.95.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@duckdb/node-api": "2.0.0-r.1",
    "bcryptjs": "3.0.3",
    "jose": "6.2.17",
    "pg": "^8.23.1"
  }
}
